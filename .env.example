# Copy to .env.local (never commit it) and add the same keys in Vercel → Settings → Environment Variables.
# Claude via Amazon Bedrock (hackathon access)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
# …or directly via Anthropic instead:
ANTHROPIC_API_KEY=
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_SECRET=change-me-too

# Optional overrides
# TUTOR_MODEL=anthropic.claude-sonnet-5-5
# ANALYZER_MODEL=anthropic.claude-haiku-5-5
